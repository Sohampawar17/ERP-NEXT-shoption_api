        if name:
            doc = frappe.get_doc("State Master", name)
            doc.state_name = state_name
            if country_name:
                doc.country = country_name
            doc.save(ignore_permissions=True)
            updated += 1
        else:
            doc = frappe.new_doc("State Master")
            try:
                doc.name = str(state_id)
            except Exception:
                pass
            doc.state_id = int(state_id) if str(state_id).isdigit() else state_id
            doc.state_name = state_name
            if country_name:
                doc.country = country_name
            doc.insert(ignore_permissions=True)
            created += 1
    frappe.db.commit()
    frappe.logger().info(f"State import complete. created={created}, updated={updated}")

