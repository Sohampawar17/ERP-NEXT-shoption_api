# import_master.py
import frappe
from openpyxl import load_workbook
from frappe.utils import now_datetime
from datetime import timedelta
import csv
import os

DATA_DIR = frappe.get_app_path("shoption_api", "data_import")

def _load_sheet_rows(path, sheet_name=None):
    wb = load_workbook(path, read_only=True, data_only=True)
    if sheet_name:
        ws = wb[sheet_name]
    else:
        ws = wb[wb.sheetnames[0]]
    rows = list(ws.iter_rows(values_only=True))
    if not rows:
        return []
    headers = [str(h).strip() if h is not None else "" for h in rows[0]]
    data = []
    for r in rows[1:]:
        row = {}
        for i, val in enumerate(r):
            if i < len(headers) and headers[i]:
                row[headers[i].strip()] = val
        data.append(row)
    return data

def _safe_str(v):
    return "" if v is None else str(v).strip()

def import_country(filename="country.xlsx"):
    path = f"{DATA_DIR}/{filename}"
    frappe.logger().info(f"Import Country from {path}")
    rows = _load_sheet_rows(path)
    created = 0
    updated = 0
    for r in rows:
        country_id = _safe_str(r.get("country_id") or r.get("CountryId") or r.get("id"))
        country_name = _safe_str(r.get("country_name") or r.get("CountryName") or r.get("name"))
        if not country_id:
            frappe.logger().warning("Skipping row without country_id")
            continue
        # find existing
        name = frappe.db.get_value("Country Master", {"country_id": country_id}, "name")
        if name:
            doc = frappe.get_doc("Country Master", name)
            doc.country_name = country_name
            doc.save(ignore_permissions=True)
            updated += 1
        else:
            doc = frappe.new_doc("Country Master")
            # keep a stable name by using country_id as name if possible
            try:
                doc.name = str(country_id)
            except Exception:
                pass
            doc.country_id = int(country_id) if str(country_id).isdigit() else country_id
            doc.country_name = country_name
            doc.insert(ignore_permissions=True)
            created += 1
    frappe.db.commit()
    frappe.logger().info(f"Country import complete. created={created}, updated={updated}")

